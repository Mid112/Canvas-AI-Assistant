# Postgres
POSTGRES_USER=appuser
POSTGRES_PASSWORD=localdev
POSTGRES_DB=appdb

# Canvas — stubbed out for local testing
CANVAS_API_URL=http://placeholder.local
CANVAS_API_TOKEN=placeholder_token

# Backend
SECRET_KEY=localdevsecret
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
