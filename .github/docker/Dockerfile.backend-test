# Preinstall backend deps for CI pytest (Linux/amd64 under Docker Desktop).
# Image tag should include the requirements.txt hash so rebuilds only happen
# when dependencies change.
FROM python:3.12-slim-bookworm

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

WORKDIR /workspace/app/backend
ENV PYTHONPATH=/workspace/app/backend
