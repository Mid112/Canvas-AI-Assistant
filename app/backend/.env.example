# Copy this file to .env and fill in your values
PROJECT_NAME=Canvas Helper AI Assistant
API_V1_PREFIX=/api/v1
DEBUG=true

# CORS - comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://appuser:localdev@localhost:5433/appdb

# Auth
SECRET_KEY=localdevsecret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Canvas API
# For local Canvas Docker, keep CANVAS_API_URL pointed at localhost. Saved Canvas
# connections preserve this URL so post-connect auth refreshes and later Canvas
# requests target the same Canvas host instead of falling back to a backend default.
CANVAS_API_URL=http://localhost:3000
CANVAS_API_TOKEN=your-canvas-access-token-here

# Encryption key for Canvas tokens stored in DB — generate your own:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CANVAS_TOKEN_ENCRYPTION_KEY=your-generated-fernet-key-here
