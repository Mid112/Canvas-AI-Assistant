# Copy this file to .env and fill in your values
PROJECT_NAME=Canvas Helper AI Assistant
API_V1_PREFIX=/api/v1
DEBUG=true

# CORS - comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://appuser:localdev@localhost:5433/appdb

# Auth
SECRET_KEY=localdevsecret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Canvas API
# For local Canvas Docker, keep CANVAS_API_URL pointed at localhost. Saved Canvas
# connections preserve this URL so post-connect auth refreshes and later Canvas
# requests target the same Canvas host instead of falling back to a backend default.
CANVAS_API_URL=http://localhost:3000
CANVAS_API_TOKEN=your-canvas-access-token-here

# Encryption key for Canvas tokens stored in DB — generate your own:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CANVAS_TOKEN_ENCRYPTION_KEY=your-generated-fernet-key-here

# LLM — Hugging Face Inference Router (hosted, OpenAI-compatible, no local
# setup required). Get a token at huggingface.co/settings/tokens —
# required when DEFAULT_LLM_PROVIDER=huggingface (the default below).
# HF_MODEL is pinned to Groq's backing via the ":groq" suffix — an
# unpinned model id (no suffix) lets HF's router pick whichever provider
# currently backs it, which was tried first and was unusably slow for a
# thinking model (one real request hit the 90s timeout outright). Pinning
# to a specific fast provider is a real tradeoff: no automatic failover
# if that provider has an outage.
HF_TOKEN=
DEFAULT_LLM_PROVIDER=huggingface
HF_MODEL=openai/gpt-oss-20b:groq

# LLM — Groq (hosted, OpenAI-compatible, no local setup required)
# Get a free key at console.groq.com — required when DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=
# "Thinking" model (reasons in a <think> block before answering) — needed
# for course-name resolution's reasoning over a candidate list (see
# services/chat.py). To use the older plain instruct model instead, set
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL=qwen/qwen3.6-27b

# LLM — local providers (OpenAI-compatible)
# vLLM: make install-vllm && make run-vllm
# Ollama: make install-ollama && make run-ollama
VLLM_BASE_URL=http://host.docker.internal:8001/v1
VLLM_MODEL=Qwen/Qwen3-4B
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
