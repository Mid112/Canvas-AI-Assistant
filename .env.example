# Copy to .env in the project root: cp .env.example .env
# Required for the backend to start (encrypts Canvas tokens in the database).

# Generate your own for production:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CANVAS_TOKEN_ENCRYPTION_KEY=WLtI-3iEKUF5Js2PoXe99Gx4tmmNkTyfguYL3118pBY=

# Optional system Canvas URL for health checks, MCP default calls, and explicit
# single-institution deployments. Leave empty for multi-institution installs
# where every request should carry the selected/course Canvas URL.
CANVAS_API_URL=

# MCP is disabled by default. To enable it in a deployed environment, set
# MCP_ENABLED=true and replace the allowlist below with every real Canvas host
# the MCP sidecar may call when the backend forwards a user/course canvas_url.
MCP_ENABLED=false

# Required when MCP_ENABLED=true. Use hostnames only, comma-separated. Do not
# use "*", URL paths, localhost, or local service names in deployed environments.
# Examples:
#   MCP_ALLOWED_CANVAS_HOSTS=canvas.example.edu
#   MCP_ALLOWED_CANVAS_HOSTS=canvas.example.edu,canvas.other.edu
# Local sandbox hosts are already configured in docker-compose.dev.yml.
MCP_ALLOWED_CANVAS_HOSTS=
